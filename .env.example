# 이 파일을 복사해서 .env 파일을 만들고 본인 키를 채워 넣으세요.
# 터미널에서:  cp .env.example .env

# Kakao 지도 JavaScript 키 (필수)
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
REACT_APP_KAKAO_KEY=여기에_카카오_JS_키

# Firebase Realtime Database 주소 (선택)
# 비워두면 ESP32 연동 없이 시뮬레이션만 동작합니다.
# 예) https://smart-trash-xxxx-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_DB_URL=
